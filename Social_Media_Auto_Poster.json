      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "console.log('Raw Date field:', JSON.stringify($json.fields.Date));\nconsole.log('Raw Time field:', JSON.stringify($json.fields.Time));\n\nconst dateStr = String($json.fields.Date || '').trim();\nconst timeStr = String($json.fields.Time || '').trim();\nconst combined = dateStr + 'T' + timeStr;\nconst parsedDate = new Date(combined);\n\nconsole.log('Combined string:', combined);\nconsole.log('Parsed date:', parsedDate);\nconsole.log('Is valid:', !isNaN(parsedDate.getTime()));\n\nif (!isNaN(parsedDate.getTime()) && parsedDate <= new Date()) {\n  return $input.item;\n}\n\nreturn null;"
      },
