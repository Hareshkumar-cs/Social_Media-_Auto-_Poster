    {
      "parameters": {
        "jsCode": "const generatedText = $json.candidates[0].content.parts[0].text;\n\n// Escape characters that would break JSON string literals\nconst safeText = generatedText\n  .replace(/\\\\/g, '\\\\\\\\')\n  .replace(/\"/g, '\\\\\"')\n  .replace(/\\n/g, '\\\\n')\n  .replace(/\\r/g, '\\\\r');\n\nreturn {\n  ...$('Check If Due Now').item.json,\n  fields: {\n    ...$('Check If Due Now').item.json.fields,\n    Caption: safeText\n  }\n};"
      },
